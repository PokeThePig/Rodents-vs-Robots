[sub_resource type="GDScript" id="GDScript_1bvp3"]
script/source = "extends Camera2D

@export var zoom_speed: float = 1.0
const ZOOM_LEVELS = [.75, .6, .55, .5]
var zoom_index: int = 0
var target_zoom: Vector2 = Vector2(.75, .75)

func _ready() -> void:
	zoom = target_zoom

func _process(delta: float) -> void:
	zoom = zoom.lerp(target_zoom, zoom_speed * delta)

func zoom_out_for_new_rodent() -> void:
	if zoom_index < ZOOM_LEVELS.size() - 1:
		zoom_index += 1
		var z = ZOOM_LEVELS[zoom_index]
		target_zoom = Vector2(z, z)
"

